# ====================================================================
# GyanSetu — Environment Variables Template
# ====================================================================
# Copy this file to .env and replace the values with your Supabase project keys.
# Never commit your real .env file with private keys to GitHub.
# ====================================================================

# Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe for browser client-side usage)
SUPABASE_ANON=your-supabase-anon-key-here

# Optional: Port for local HTTP development server
PORT=3000
