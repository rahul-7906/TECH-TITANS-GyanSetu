# GyanSetu Open Source .gitignore

# Environment & Secret Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js

# Build Outputs & Edge Caches
.vercel/
dist/
build/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & IDE Configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Temporary / Scratch Files
scratch/
.system_generated/
*.tmp
*.bak
